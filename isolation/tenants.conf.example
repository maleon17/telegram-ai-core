# Root-owned configuration for the optional Unix tenant isolation module.
TENANTS_ROOT=@TENANTS_ROOT@
TENANT_GROUP=aitenants
USER_PREFIX=t
UID_MIN=20000
UID_MAX=29999
REGISTRY_DIR=/var/lib/telegram-ai/tenants
BRIDGE_USER=@BRIDGE_USER@
BRIDGE_GROUP=@BRIDGE_GROUP@
REQUIRE_MOUNT=@REQUIRE_MOUNT@
DISK_QUOTA_KB=@DISK_QUOTA_KB@
DISK_INODES=@DISK_INODES@
MEMORY_MAX=@MEMORY_MAX@
TASKS_MAX=1024
USE_SYSTEMD_SCOPE=1
ALLOW_LOOPBACK_TCP=
ADMIN_IDS=@ADMIN_IDS@
ADMIN_GROUP=aitenants-admin
ADMIN_MEMORY_MAX=8G
ADMIN_TASKS_MAX=4096
